#version 450
// Packs one output frame (RGBA8 image in VRAM) into the byte layouts its
// consumers need, written straight into host-readable buffers: BGRA for the
// GUI preview and YUYV / NV12 / RGBA for the virtual cameras. One invocation
// handles a 4x2 pixel block so every write is a whole 32-bit word.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D src;
layout(std430, set = 0, binding = 1) writeonly buffer Preview { uint words[]; } preview;
layout(std430, set = 0, binding = 2) writeonly buffer Output { uint words[]; } outbuf;

layout(push_constant) uniform Params {
  uint width;
  uint height;
  uint want_preview;  // 1 = write BGRA preview
  uint out_format;    // 0 = none, 1 = YUYV, 2 = NV12, 3 = RGBA
} pc;

uint to_byte(float v) { return uint(clamp(v, 0.0, 255.0) + 0.5); }

// BT.601 limited range, matching the CPU convert_rgba_to_* helpers.
vec3 to_yuv(vec3 rgb) {
  vec3 c = rgb * 255.0;
  return vec3(( 66.0 * c.r + 129.0 * c.g +  25.0 * c.b) / 256.0 + 16.0,
              (-38.0 * c.r -  74.0 * c.g + 112.0 * c.b) / 256.0 + 128.0,
              (112.0 * c.r -  94.0 * c.g -  18.0 * c.b) / 256.0 + 128.0);
}

uint pack4(uint a, uint b, uint c, uint d) { return a | (b << 8u) | (c << 16u) | (d << 24u); }

void main() {
  uvec2 block = gl_GlobalInvocationID.xy;
  uint x0 = block.x * 4u;
  uint y0 = block.y * 2u;
  if (x0 >= pc.width || y0 >= pc.height) {
    return;
  }

  vec3 px[2][4];
  for (uint r = 0u; r < 2u; ++r) {
    for (uint i = 0u; i < 4u; ++i) {
      px[r][i] = imageLoad(src, ivec2(x0 + i, y0 + r)).rgb;
    }
  }

  for (uint r = 0u; r < 2u; ++r) {
    uint row = y0 + r;
    for (uint i = 0u; i < 4u; ++i) {
      uint index = row * pc.width + x0 + i;
      uvec3 c = uvec3(to_byte(px[r][i].r * 255.0), to_byte(px[r][i].g * 255.0), to_byte(px[r][i].b * 255.0));
      if (pc.want_preview != 0u) {
        preview.words[index] = pack4(c.b, c.g, c.r, 255u);
      }
      if (pc.out_format == 3u) {
        outbuf.words[index] = pack4(c.r, c.g, c.b, 255u);
      }
    }
  }

  if (pc.out_format == 1u) {
    for (uint r = 0u; r < 2u; ++r) {
      uint row = y0 + r;
      for (uint pair = 0u; pair < 2u; ++pair) {
        vec3 a = to_yuv(px[r][pair * 2u]);
        vec3 b = to_yuv(px[r][pair * 2u + 1u]);
        uint word = (row * pc.width + x0 + pair * 2u) / 2u;
        outbuf.words[word] = pack4(to_byte(a.x), to_byte((a.y + b.y) * 0.5), to_byte(b.x), to_byte((a.z + b.z) * 0.5));
      }
    }
  } else if (pc.out_format == 2u) {
    vec3 yuv[2][4];
    for (uint r = 0u; r < 2u; ++r) {
      for (uint i = 0u; i < 4u; ++i) {
        yuv[r][i] = to_yuv(px[r][i]);
      }
      uint row = y0 + r;
      outbuf.words[(row * pc.width + x0) / 4u] =
          pack4(to_byte(yuv[r][0].x), to_byte(yuv[r][1].x), to_byte(yuv[r][2].x), to_byte(yuv[r][3].x));
    }
    vec2 uv0 = (yuv[0][0].yz + yuv[0][1].yz + yuv[1][0].yz + yuv[1][1].yz) * 0.25;
    vec2 uv1 = (yuv[0][2].yz + yuv[0][3].yz + yuv[1][2].yz + yuv[1][3].yz) * 0.25;
    uint uv_word = (pc.width * pc.height + (y0 / 2u) * pc.width + x0) / 4u;
    outbuf.words[uv_word] = pack4(to_byte(uv0.x), to_byte(uv0.y), to_byte(uv1.x), to_byte(uv1.y));
  }
}
